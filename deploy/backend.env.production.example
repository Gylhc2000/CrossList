# ============================================================
# 服务器端后端配置模板 —— 复制为 backend/.env 后填写真实值
#   cp deploy/backend.env.production.example backend/.env
#   chmod 600 backend/.env            # 内含 API Key，禁止他人读
#
# 注意：本文件是模板，提交到 git 是安全的（无真实密钥）。
# 真正的 backend/.env 已被 .gitignore 排除，永远不会入库。
# ============================================================

# ---------- 大模型（OpenAI 兼容协议）----------
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=在此填写你的APIKey

# 文本模型：实测 deepseek-v4-flash 比 qwen3.6-flash 快约 3 倍且规则错误更少
LLM_TEXT_MODEL=deepseek-v4-flash
# 主模型连续失败时的兜底模型（评分环节降级用）
LLM_TEXT_MODEL_FALLBACK=qwen3.6-flash

LLM_IMAGE_MODEL=qwen-image-2.0
LLM_AUDIO_MODEL=qwen-audio-3.0-tts-plus
# 图像接口独立基地址：留空则复用 LLM_BASE_URL（一般保持留空）
LLM_IMAGE_BASE_URL=

# ---------- 服务 ----------
BACKEND_PORT=8000
# 后端只监听回环，公网入口统一交给 nginx。改成 0.0.0.0 前先确认 COOKIE_SECURE=true
BACKEND_HOST=127.0.0.1
OUTPUT_DIR=./output

# ---------- 账号与会话 ----------
DATA_DIR=./data/crosslist.db          # SQLite：账号 / 会话 / 任务归属与历史
SESSION_TTL_DAYS=7
# 公网 HTTPS 下必须 true，否则会话 Cookie 明文可被同网段嗅探
COOKIE_SECURE=true
# 保持 false：注册要邀请码，否则公网会被脚本批量注册共用同一把模型 Key
ALLOW_OPEN_SIGNUP=false
INVITE_CODE=openssl rand -hex 16 生成一个
USER_DAILY_JOB_LIMIT=10               # 每人每自然日的任务数上限
DOWNLOAD_MAX_CONCURRENCY=2            # 同时打包下载数，超出返回 429
# 受信反代地址。uvicorn 的 --forwarded-allow-ips 必须与之一致，且不要写 *：
# 写 * 会让攻击者能伪造 X-Forwarded-For，把登录限速和审计日志的 ip 字段一起废掉
TRUSTED_PROXIES=127.0.0.1,::1
ADMIN_USERNAMES=你的用户名             # 逗号分隔；空库时第一个注册者也会成为管理员
# 运行时改写模型地址/Key 的能力。除非确实要在页面上改，否则保持 false：
# 开着时 POST /api/test 会把真实 API Key 发往请求里指定的任意地址
ALLOW_RUNTIME_CONFIG=false

# 跨域白名单（逗号分隔）。
# 同机 + nginx 单入口时前端同源，用不上但仍建议填上以防直连调试。
# 方案 B（前端在 Vercel / 另一台机器）时必须填前端的真实来源，否则浏览器请求全被 CORS 拦掉。
# 另：这一项同时是"可信写请求来源"清单的一分子（见 same_site_ok）。
# 例：CORS_ORIGINS=http://1.2.3.4,http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# ---------- 产物清理 ----------
# 任务产物超过 TTL 小时后删除，每 interval 分钟扫一轮；TTL 设 0 可禁用
CLEANUP_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# ---------- 阿里云 OSS（可选的产物镜像备份；留 false 不影响任何功能，
#             产物以本地 output/ 为准、下载走本服务 zip，卖家无需自备图床）----------
OSS_ENABLED=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
