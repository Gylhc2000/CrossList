# ============================================================
# CrossList AI 后端服务（FastAPI + LangGraph）
# 安装：sudo cp deploy/crosslist-backend.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now crosslist-backend
# ============================================================
[Unit]
Description=CrossList AI Backend (FastAPI + LangGraph)
Documentation=https://github.com/<your-account>/<your-repo>
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crosslist
Group=crosslist
WorkingDirectory=/opt/crosslist/backend

# ⚠️ --workers 必须为 1
# 任务状态（JobManager）与 SSE 订阅者都存在【进程内存】里。
# 开多 worker 后：任务在 worker A 创建，请求被负载到 worker B 就查不到 → 404 / 进度页空白。
# 需要更高并发请改造成 Redis 等外部状态存储，而不是加 worker。
# ⚠️ --forwarded-allow-ips 必须与 .env 的 TRUSTED_PROXIES 一致，且【不要写 *】：
# 写 * 等于相信任何来源转来的 X-Forwarded-For，攻击者可以每次换一个伪造值，
# 让登录限速（按 来源IP+用户名 计数）彻底失效，审计日志里的 ip 也会变成假的。
# 同机 nginx 就是 127.0.0.1；反代在别的机器/容器就填那台机器的地址。
ExecStart=/opt/crosslist/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1

# 配置来源是 backend/.env（pydantic-settings 自动读取），不需要 EnvironmentFile。
# 服务账号需要对工作目录有写权限：
#   backend/.env            —— 仅在 ALLOW_RUNTIME_CONFIG=true 时才会被改写
#   backend/data/*.db*      —— SQLite（账号 / 会话 / 任务历史），WAL 模式需要写 -wal/-shm
#   backend/output/         —— 任务产物与打包临时文件
# 例：sudo install -d -o crosslist -g crosslist /opt/crosslist/backend/{data,output}
#     sudo chmod 600 /opt/crosslist/backend/.env && sudo chown crosslist /opt/crosslist/backend/.env
Environment=PYTHONUNBUFFERED=1

Restart=always
RestartSec=3
TimeoutStopSec=20

# 日志：journalctl -u crosslist-backend -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crosslist-backend

# 基础加固（不影响本项目的文件读写）
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
