# ============================================================
# CrossList AI 后端服务（FastAPI + LangGraph）
# 安装：sudo cp deploy/crosslist-backend.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now crosslist-backend
# ============================================================
[Unit]
Description=CrossList AI Backend (FastAPI + LangGraph)
Documentation=https://github.com/<your-account>/<your-repo>
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crosslist
Group=crosslist
WorkingDirectory=/opt/crosslist/backend

# ⚠️ --workers 必须为 1
# 任务状态（JobManager）与 SSE 订阅者都存在【进程内存】里。
# 开多 worker 后：任务在 worker A 创建，请求被负载到 worker B 就查不到 → 404 / 进度页空白。
# 需要更高并发请改造成 Redis 等外部状态存储，而不是加 worker。
ExecStart=/opt/crosslist/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips='*'

# 配置来源是 backend/.env（pydantic-settings 自动读取），不需要 EnvironmentFile。
# 但前端「⚙ 模型配置」保存时是直接改写 .env 文件的，
# 所以 crosslist 这个账号必须对该文件有写权限，否则保存报 500。
Environment=PYTHONUNBUFFERED=1

Restart=always
RestartSec=3
TimeoutStopSec=20

# 日志：journalctl -u crosslist-backend -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crosslist-backend

# 基础加固（不影响本项目的文件读写）
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
