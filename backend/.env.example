# 复制为 .env 后填写
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=在此填写你的APIKey
LLM_TEXT_MODEL=qwen3.8-max
LLM_IMAGE_MODEL=qwen-image-2.0
LLM_AUDIO_MODEL=qwen-audio-3.0-tts-plus

BACKEND_PORT=8000
# 默认只监听回环。要外部访问需显式改 0.0.0.0，并同时把 COOKIE_SECURE 设为 true
BACKEND_HOST=127.0.0.1
OUTPUT_DIR=./output
CORS_ORIGINS=http://localhost:3000

# ---- 账号与会话（SQLite，标准库实现，无需额外依赖）----
DATA_DIR=./data/crosslist.db
SESSION_TTL_DAYS=7
# 公网 HTTPS 部署必须为 true，否则会话 Cookie 会明文传输
COOKIE_SECURE=false
# 保持 false：注册需要邀请码，避免被脚本批量注册刷模型额度
ALLOW_OPEN_SIGNUP=false
INVITE_CODE=在这里填一个随机长字符串
# 每人每自然日可创建的任务数上限
USER_DAILY_JOB_LIMIT=10
# 同时打包下载的请求数，超出直接 429（打包是 CPU + 磁盘写，单 worker 下会互相拖死）
DOWNLOAD_MAX_CONCURRENCY=2
# 受信反代地址（逗号分隔）：只有直连对端在这里，才相信它转来的 X-Forwarded-For。
# 千万不要写 *，否则登录限速可被伪造来源绕掉；uvicorn 的 --forwarded-allow-ips 要跟这里一致
TRUSTED_PROXIES=127.0.0.1,::1
# 逗号分隔的管理员用户名（空库时第一个注册者自动成为管理员）
ADMIN_USERNAMES=
# 允许在运行时改写模型服务地址与 Key。默认关：
# 开着且未鉴权时，POST /api/test 会把真实 API Key 送到请求里指定的任意地址
ALLOW_RUNTIME_CONFIG=false

# 同时运行的任务数，超出的排队等待（状态保持 queued）
JOB_MAX_CONCURRENCY=2
# 排队 + 运行中的任务总数上限，超出返回 429（排队任务也占内存）
JOB_MAX_LIVE=8
# 单个素材包 zip 的体积上限（MB），超出返回 413。打包已流式化，这里守的是磁盘
ZIP_MAX_MB=1024

# 阿里云 OSS：**可选的产物镜像备份**，默认关。产物以本地 output/ 为准，
# 卖家下载走本服务的 zip；不开 OSS 不影响任何功能，也不需要卖家自备图床。
OSS_ENABLED=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
